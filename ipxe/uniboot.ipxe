#!ipxe
# UniBoot Custom iPXE Menu
# Copyright (c) 2026-present SnowdreamTech Inc.

# Initialize network if not already configured
isset ${ip} || dhcp || echo DHCP failed, network may be unavailable

# Load UniBoot brand background picture (local USB first, GitHub cloud fallback)
console --picture file:/ventoy/themes/uniboot/background.png || console --picture https://raw.githubusercontent.com/snowdreamtech/UniBoot/main/ventoy/themes/uniboot/background.png ||

:custom
clear custom_choice
menu UniBoot - Unified Network Boot Platform
item --gap --             ---------------- Operating Systems ----------------
item ubuntu               Install Ubuntu Linux
item debian               Install Debian Linux
item fedora               Install Fedora Linux
item win11                Install Windows 11 Official
item --gap --             ---------------- Official Tools ----------------
item netboot_official     Official Netboot.xyz Main Menu
item --gap --             ---------------- System Control ----------------
item reboot               Reboot System
item exit                 Return to Ventoy / Exit
choose custom_choice || goto custom_exit

:ubuntu
chain https://boot.netboot.xyz/ubuntu.ipxe

:debian
chain https://boot.netboot.xyz/debian.ipxe

:fedora
chain https://boot.netboot.xyz/fedora.ipxe

:win11
chain https://boot.netboot.xyz/windows.ipxe

:netboot_official
chain https://boot.netboot.xyz/menu.ipxe

:reboot
reboot

:exit
exit

:custom_exit
exit 0
